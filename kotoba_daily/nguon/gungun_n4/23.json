 "ngu_phap": [
  {"id": "23-1", "mau": "Aは/がBに/からNをもらう", "nghia": "A nhận N từ B", "vi_du": "友達から手紙をもらいました。"},
  {"id": "23-2", "mau": "Aは/がBに/からNをいただく", "nghia": "A nhận N từ B (người trên): khiêm nhường", "vi_du": "先生に辞書をいただきました。"},
  {"id": "23-3", "mau": "Aは/がBに/からVて＋もらう", "nghia": "A được B V cho", "vi_du": "姉に宿題を手伝ってもらいました。"},
  {"id": "23-4", "mau": "Aは/がBに/からVて＋いただく", "nghia": "A được B (người trên) V cho", "vi_du": "部長に書類を見ていただきました。"},
  {"id": "23-5", "mau": "Vて＋もらえませんか / いただけませんか", "nghia": "Bạn có thể V giúp tôi được không? Nhờ vả lịch sự, với người trên dùng いただけませんか", "vi_du": "もう一度説明していただけませんか。"},
  {"id": "23-6", "mau": "Vて＋ほしい", "nghia": "Muốn (ai đó) V: mong người khác làm việc gì", "vi_du": "夫に早く帰ってきてほしいです。"},
  {"id": "23-7", "mau": "Cặp động từ: 貸す↔借りる, 教える↔教わる, 預ける↔預かる", "nghia": "Cùng một sự việc nhìn từ hai phía: AがBにNを貸す thì BがAに/からNを借りる", "vi_du": "友達に漢字を教わりました。"},
  {"id": "23-8", "mau": "Thể bị động (受身形)", "nghia": "Cách chia thể bị động Vられる của ba nhóm động từ", "vi_du": "朝早く弟に起こされました。"},
  {"id": "23-9", "mau": "Aは/がBをVます → Bは/がAにVられます", "nghia": "B bị, được A V: bị động trực tiếp", "vi_du": "部長に褒められました。"},
  {"id": "23-10", "mau": "Aは/が(Bの)NをVます → Bは/がAにNをVられます", "nghia": "B bị A V (đồ vật, bộ phận của B): thường mang cảm giác phiền", "vi_du": "電車で足を踏まれました。"},
  {"id": "23-11", "mau": "(Aは/が)NをVます → Nは/が(Aによって)Vられます", "nghia": "N được V (bởi A): chủ ngữ là vật, nêu sự thật khách quan", "vi_du": "この小説は多くの国で読まれています。"}
 ],
