 "ngu_phap": [
  {"id": "27-1", "mau": "Vては/では・Vちゃ/じゃ＋いけない/だめ", "nghia": "Không được V: cấm đoán, Vちゃ/じゃ là dạng văn nói", "vi_du": "ここで泳いじゃだめだよ。"},
  {"id": "27-2", "mau": "Vなくては・Vなくちゃ＋いけない/だめ", "nghia": "Phải V: bắt buộc, Vなくちゃ là dạng văn nói", "vi_du": "薬を飲まなくちゃいけない。"},
  {"id": "27-3", "mau": "Vてしまう＝Vちゃう / Vでしまう＝Vじゃう (tiếc nuối)", "nghia": "Lỡ V mất rồi: hối tiếc về việc đã xảy ra", "vi_du": "大事なデータを消しちゃった。"},
  {"id": "27-4", "mau": "Vてしまう＝Vちゃう / Vでしまう＝Vじゃう (hoàn thành)", "nghia": "V xong hết: hoàn thành trọn vẹn", "vi_du": "この本は一日で読んでしまいました。"},
  {"id": "27-5", "mau": "Vて＋おく", "nghia": "V sẵn, V trước: chuẩn bị hoặc giữ nguyên trạng thái", "vi_du": "友達が来る前に部屋を掃除しておきます。"},
  {"id": "27-6", "mau": "Vて＋くる", "nghia": "Đi V rồi quay lại", "vi_du": "ちょっとコンビニで飲み物を買ってきます。"},
  {"id": "27-7", "mau": "〜Vていく/〜Vてくる (1)", "nghia": "V đi xa, V đến gần: hướng di chuyển so với người nói", "vi_du": "向こうから犬が走ってきました。"},
  {"id": "27-8", "mau": "〜Vていく/〜Vてくる (2)", "nghia": "Dần dần ~: thay đổi từ trước đến nay (てくる), từ nay về sau (ていく)", "vi_du": "最近、日本語が面白くなってきました。"}
