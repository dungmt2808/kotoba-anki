  {"id": "15-1", "mau": "Thể thường/N/Aな＋でしょう/だろう (phán đoán)", "nghia": "Chắc là ~: phán đoán, dự báo, không dùng cho hành động có ý chí của chính mình", "vi_du": "明日は晴れるでしょう。"},
  {"id": "15-2", "mau": "Thể thường/N/Aな＋でしょう (xác nhận)", "nghia": "~ phải không? Xác nhận, kêu gọi đồng tình, lên giọng cuối câu", "vi_du": "この映画、面白かったでしょう？"},
  {"id": "15-3", "mau": "Thể thường/N/Aな＋かもしれない", "nghia": "Có lẽ ~, có khi ~ không chừng: khả năng không chắc chắn", "vi_du": "午後は雨が降るかもしれない。"},
  {"id": "15-4", "mau": "Thể thường/N/Aな＋みたいだ", "nghia": "Hình như ~: phán đoán theo cảm nhận, dùng trong văn nói", "vi_du": "田中さんは風邪を引いたみたいだ。"},
  {"id": "15-5", "mau": "Thể thường/Nの/Aな＋ようだ", "nghia": "Hình như ~: phán đoán dựa trên quan sát, trang trọng hơn みたいだ", "vi_du": "隣の部屋に誰かいるようだ。"},
  {"id": "15-6", "mau": "Thể thường/Nの/Aな＋はずだ", "nghia": "Chắc chắn ~ theo lý: phán đoán có căn cứ", "vi_du": "鈴木さんは今日来るはずです。"}
