  {"id": "18-1", "mau": "(＋)Aい/Aな＋そう (ー)Aいく＋なさそう / Aなでは/じゃ＋なさそう", "nghia": "Trông có vẻ ~: nhận xét từ bề ngoài, dạng phủ định là trông có vẻ không ~", "vi_du": "このケーキはおいしそうです。"},
  {"id": "18-2", "mau": "Vます＋そう", "nghia": "Sắp ~ đến nơi: dấu hiệu ngay trước mắt", "vi_du": "あ、コップが落ちそうです。"},
  {"id": "18-3", "mau": "(＋)Vます＋そう (ー)Vない＋な(さ)そう", "nghia": "Có vẻ (sẽ) ~: dự đoán từ tình hình hiện tại", "vi_du": "今年は試験に合格できそうです。"},
  {"id": "18-4", "mau": "Aいく/Aなに/Nに＋V", "nghia": "V sao cho A, thành N: tính từ, danh từ bổ nghĩa cho động từ", "vi_du": "名前を大きく書いてください。"},
  {"id": "18-5", "mau": "Aいく/Aなに/Nに＋する", "nghia": "Làm cho ~: chủ động thay đổi trạng thái", "vi_du": "部屋をきれいにしました。"},
  {"id": "18-6", "mau": "Aいく/Aなに＋なる", "nghia": "Trở nên ~: sự thay đổi trạng thái", "vi_du": "最近、暑くなりました。"}
