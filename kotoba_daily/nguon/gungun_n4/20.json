  {"id": "20-1", "mau": "Cách tạo Mệnh đề bổ nghĩa cho danh từ (1)", "nghia": "N mà (ai đó) V: N là tân ngữ của mệnh đề đứng trước", "vi_du": "昨日買った本はとても面白いです。"},
  {"id": "20-2", "mau": "Cách tạo Mệnh đề bổ nghĩa cho danh từ (2)", "nghia": "N V: N là chủ ngữ của mệnh đề đứng trước", "vi_du": "あそこで歌っている人は私の兄です。"},
  {"id": "20-3", "mau": "Cách tạo Mệnh đề bổ nghĩa cho danh từ (3)", "nghia": "N mà ~: N là từ chung chỉ thời gian, nơi chốn, người", "vi_du": "友達と初めて会った場所はこのカフェです。"},
  {"id": "20-4", "mau": "Mệnh đề bổ nghĩa danh từ trong các trường hợp cụ thể", "nghia": "Mệnh đề bổ nghĩa gắn cho các thành phần trong câu như chủ ngữ, tân ngữ, dù dài vẫn chỉ là một thành phần", "vi_du": "姉が作ったケーキを友達と食べました。"},
  {"id": "20-5", "mau": "〜声/音/におい/味/感じ＋が＋する", "nghia": "Có tiếng, âm thanh, mùi, vị, cảm giác ~: cảm nhận qua giác quan", "vi_du": "台所からいいにおいがします。"},
  {"id": "20-6", "mau": "(人に)〜が＋見える/聞こえる", "nghia": "(Ai) nhìn thấy, nghe thấy ~ một cách tự nhiên", "vi_du": "窓から海が見えます。"},
  {"id": "20-7", "mau": "Nが＋わかる", "nghia": "Hiểu N, biết N: đối tượng đứng trước が", "vi_du": "この言葉の意味がわかりますか。"}
