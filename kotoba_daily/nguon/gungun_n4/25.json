 "ngu_phap": [
  {"id": "25-1", "mau": "Nにする", "nghia": "Chọn N, quyết định N", "vi_du": "飲み物は紅茶にします。"},
  {"id": "25-2", "mau": "Vる/Vない＋ことにする", "nghia": "Quyết định V, quyết định không V: do tự mình quyết định", "vi_du": "来年、日本へ留学することにしました。"},
  {"id": "25-3", "mau": "Vる/Vない＋ことになる", "nghia": "Được quyết định là ~: kết quả không do ý mình", "vi_du": "四月から大阪で働くことになりました。"},
  {"id": "25-4", "mau": "Vる/Vない＋ようにする", "nghia": "Cố gắng V, cố gắng không V: tạo thói quen, ようにしている là đang duy trì", "vi_du": "毎日野菜を食べるようにしています。"},
  {"id": "25-5", "mau": "Vる/Vない＋ようにしてください", "nghia": "Xin hãy cố gắng V, cố gắng đừng V", "vi_du": "授業に遅れないようにしてください。"},
  {"id": "25-6", "mau": "Vる＋ようになる", "nghia": "Bắt đầu (có thói quen) V, trở nên có thể V", "vi_du": "漢字が読めるようになりました。"},
  {"id": "25-7", "mau": "Vない → Vなくなる", "nghia": "Không còn V nữa, không còn V được nữa", "vi_du": "最近、テレビを見なくなりました。"},
  {"id": "25-8", "mau": "Nの/Vる＋予定だ", "nghia": "Dự định ~, theo kế hoạch ~: lịch trình đã định", "vi_du": "来週、東京へ出張する予定です。"},
  {"id": "25-9", "mau": "Vる/Vない＋つもりだ", "nghia": "Định V, định không V: ý định của bản thân", "vi_du": "夏休みは国に帰るつもりです。"},
  {"id": "25-10", "mau": "Vよう＋と思っている", "nghia": "Định V, đang tính V: ý định chưa chắc chắn", "vi_du": "車を買おうと思っています。"}
