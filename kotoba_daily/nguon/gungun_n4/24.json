 "ngu_phap": [
  {"id": "24-1", "mau": "Vて、〜 / N/Aなで、〜 / Aいくて、〜", "nghia": "Vì ~ nên ~: nguyên nhân dẫn đến kết quả ngoài ý muốn, cảm xúc", "vi_du": "風邪で学校を休みました。"},
  {"id": "24-2", "mau": "V1て/V1ないで、V2", "nghia": "V2 trong trạng thái (có, không) V1", "vi_du": "傘を持たないで出かけました。"},
  {"id": "24-3", "mau": "V1ないで、V2", "nghia": "Không V1 mà V2: V2 thay thế cho V1", "vi_du": "バスに乗らないで、歩いて帰りました。"},
  {"id": "24-4", "mau": "V1ます＋ながら、V2", "nghia": "Vừa V1 vừa V2: hai hành động đồng thời, V2 là chính", "vi_du": "音楽を聞きながら、勉強します。"},
  {"id": "24-5", "mau": "(〜が)Vます＋やすい/にくい", "nghia": "Dễ V, khó V; cũng chỉ khuynh hướng dễ, khó xảy ra", "vi_du": "このペンは書きやすいです。"},
  {"id": "24-6", "mau": "Aい/Aな＋すぎる", "nghia": "Quá ~: vượt mức, thường mang ý tiêu cực", "vi_du": "この靴は大きすぎます。"},
  {"id": "24-7", "mau": "Vます＋すぎる", "nghia": "V quá nhiều, quá mức", "vi_du": "昨日、飲みすぎました。"}
 ],
