 "ngu_phap": [
  {"id": "5-1", "mau": "N(đồ vật)(は)ありますか → はい、あります / いいえ、ないです・ありません", "nghia": "Có N (đồ vật) không? Hỏi sự tồn tại của đồ vật", "vi_du": "ペンはありますか。"},
  {"id": "5-2", "mau": "N1(đồ vật)はN2(địa điểm)です / N1はN2にあります", "nghia": "N1 ở N2: nói vị trí của đồ vật", "vi_du": "トイレは二階にあります。"},
  {"id": "5-3", "mau": "N1(địa điểm)にN2(vật, địa điểm)があります", "nghia": "Ở N1 có N2", "vi_du": "駅の近くにスーパーがあります。"},
  {"id": "5-4", "mau": "N(người, động vật)(は)いますか → はい、います / いいえ、いないです・いません", "nghia": "Có N (người, con vật) không?", "vi_du": "今、田中さんはいますか。"},
  {"id": "5-5", "mau": "N1(người, động vật)はN2(địa điểm)です / N1はN2にいます", "nghia": "N1 ở N2: nói vị trí của người, con vật", "vi_du": "猫は椅子の下にいます。"},
  {"id": "5-6", "mau": "N1(địa điểm)にN2(người, động vật)がいます", "nghia": "Ở N1 có N2 (người, con vật)", "vi_du": "公園に子どもがいます。"},
  {"id": "5-7", "mau": "Nには / にも〜", "nghia": "Ở N thì có ~, ở N cũng có ~: nhấn mạnh địa điểm khi so với nơi khác", "vi_du": "この町にも大きい病院があります。"},
  {"id": "5-8", "mau": "N1とN2", "nghia": "N1 và N2: と nối các danh từ cùng loại, liệt kê đầy đủ", "vi_du": "机の上に本と辞書があります。"},
  {"id": "5-9", "mau": "Số lượng từ＋います/あります", "nghia": "Có (số lượng) người, con vật, đồ vật: số lượng từ đứng ngay trước động từ", "vi_du": "教室に学生が五人います。"}
 ],
