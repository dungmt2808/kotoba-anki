  {"id": "7-1", "mau": "どこ/誰/何＋か(trợ từ)＋Vか", "nghia": "Có V đâu đó, ai đó, cái gì đó không? Hỏi về điều chưa xác định", "vi_du": "週末、どこかへ行きますか。"},
  {"id": "7-2", "mau": "どこ/誰/何＋(trợ từ)も＋V(phủ định)", "nghia": "Chẳng V đâu, ai, gì cả: phủ định hoàn toàn", "vi_du": "今日は何も食べませんでした。"},
  {"id": "7-3", "mau": "Nを(số lượng từ)ください/お願いします", "nghia": "Cho tôi (số lượng) N: gọi món, mua hàng", "vi_du": "コーヒーを二つお願いします。"},
  {"id": "7-4", "mau": "(Khoảng thời gian＋に)＋tần suất/số lượng＋V", "nghia": "V ~ lần trong khoảng thời gian: diễn tả tần suất", "vi_du": "一週間に三回プールへ行きます。"},
  {"id": "7-5", "mau": "Vませんか / Vましょう / Vましょうか", "nghia": "Cùng V không? (mời), cùng V nào (hô hào, nhận lời), cùng V nhé? (đề nghị)", "vi_du": "土曜日に一緒に映画を見ませんか。"},
  {"id": "7-6", "mau": "Nが欲しいです", "nghia": "Muốn có N", "vi_du": "新しいパソコンが欲しいです。"},
  {"id": "7-7", "mau": "(N1へ/に)＋Vます/N2に＋行きます/来ます/帰ります", "nghia": "Đi, đến, về (N1) để V, để N2: chỉ mục đích di chuyển", "vi_du": "デパートへ靴を買いに行きます。"},
  {"id": "7-8", "mau": "NがVたいです", "nghia": "Muốn V: mong muốn của người nói", "vi_du": "日本へ行きたいです。"},
  {"id": "7-9", "mau": "Vます＋方", "nghia": "Cách V", "vi_du": "このカメラの使い方を教えてください。"}
