 "ngu_phap": [
  {"id": "3-1", "mau": "(Nは)Aいです", "nghia": "N có tính chất A: câu khẳng định với tính từ đuôi い", "vi_du": "このかばんは安いです。"},
  {"id": "3-2", "mau": "(Nは)Aいくないです", "nghia": "N không A: phủ định tính từ đuôi い (bỏ い, thêm くない)", "vi_du": "今日は寒くないです。"},
  {"id": "3-3", "mau": "(Nは)Aなです", "nghia": "N có tính chất A: câu khẳng định với tính từ đuôi な", "vi_du": "私の部屋は静かです。"},
  {"id": "3-4", "mau": "(Nは)Aなじゃないです", "nghia": "N không A: phủ định tính từ đuôi な", "vi_du": "その店は有名じゃないです。"},
  {"id": "3-5", "mau": "(Nは)Aい/Aなですか", "nghia": "N có A không? Câu hỏi với tính từ", "vi_du": "日本語は難しいですか。"},
  {"id": "3-6", "mau": "(Nは)Aいくて＋Aい/Aなです", "nghia": "N vừa A vừa A: nối tính từ đuôi い với tính từ khác", "vi_du": "この部屋は広くて明るいです。"},
  {"id": "3-7", "mau": "(Nは)Aなで＋Aい/Aなです", "nghia": "N vừa A vừa A: nối tính từ đuôi な với tính từ khác", "vi_du": "彼女はきれいで優しいです。"},
  {"id": "3-8", "mau": "(Nは)どうですか", "nghia": "N thì thế nào? Hỏi cảm nhận, đánh giá", "vi_du": "新しい仕事はどうですか。"},
  {"id": "3-9", "mau": "(Nは)〜が、〜", "nghia": "N thì ~ nhưng ~: が nối hai vế trái ý, cách nói lịch sự", "vi_du": "このパソコンは古いですが、速いです。"},
  {"id": "3-10", "mau": "(Nは)Aいかったです / Aいくなかったです", "nghia": "N đã A, đã không A: quá khứ của tính từ đuôi い", "vi_du": "昨日の映画は面白かったです。"},
  {"id": "3-11", "mau": "(Nは)Aなでした / Aなじゃなかったです", "nghia": "N đã A, đã không A: quá khứ của tính từ đuôi な", "vi_du": "先週は暇じゃなかったです。"},
  {"id": "3-12", "mau": "Aい/Aな Nです / どんなNですか", "nghia": "Tính từ đứng trước để bổ nghĩa danh từ; hỏi đặc điểm bằng どんなN", "vi_du": "ハノイはどんな町ですか。"},
  {"id": "3-13", "mau": "N1で từ để hỏi が一番Aですか → (N1で)N2が一番Aです", "nghia": "Trong N1 thì cái gì A nhất? So sánh nhất", "vi_du": "果物で何が一番好きですか。"},
  {"id": "3-14", "mau": "N1とN2(と)、どっち/どちらがAですか → N1/N2のほうがAです", "nghia": "N1 và N2 cái nào A hơn? So sánh giữa hai đối tượng", "vi_du": "犬と猫と、どちらが好きですか。"},
  {"id": "3-15", "mau": "(N1は)N2よりAです", "nghia": "N1 A hơn N2: so sánh hơn", "vi_du": "今日は昨日より暑いです。"}
 ],
