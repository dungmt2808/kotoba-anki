  {"id": "11-1", "mau": "ば形 (thể ば)", "nghia": "Cách chia thể điều kiện ば của động từ và tính từ đuôi い", "vi_du": "急げば間に合います。"},
  {"id": "11-2", "mau": "Vば/Aいければ、〜", "nghia": "Nếu ~ thì ~: câu điều kiện với động từ, tính từ đuôi い", "vi_du": "天気がよければ、海へ行きます。"},
  {"id": "11-3", "mau": "Từ nghi vấn＋Vば、〜か", "nghia": "Nên V (thế nào, khi nào, ở đâu...) thì ~? Xin lời khuyên, hỏi cách làm", "vi_du": "どこで買えば、いいですか。"},
  {"id": "11-4", "mau": "Vなければ、〜", "nghia": "Nếu không V thì không ~: câu điều kiện phủ định", "vi_du": "勉強しなければ、合格できません。"},
  {"id": "11-5", "mau": "Vなければいけません / Vないといけません", "nghia": "Phải V: nghĩa vụ, việc bắt buộc", "vi_du": "今日、レポートを出さないといけません。"},
  {"id": "11-6", "mau": "Vなきゃ、〜", "nghia": "Nếu không V thì không ~: cách nói thân mật của Vなければ", "vi_du": "急がなきゃ、間に合わないよ。"},
  {"id": "11-7", "mau": "Vなきゃいけない", "nghia": "Phải V: cách nói thân mật của Vなければいけません", "vi_du": "もう帰らなきゃいけない。"}
