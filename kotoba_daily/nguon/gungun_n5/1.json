  {"id": "1-1", "mau": "(N1は)N2です", "nghia": "N1 là N2: câu khẳng định với danh từ, dùng để giới thiệu, nêu thông tin", "vi_du": "私はエンジニアです。"},
  {"id": "1-2", "mau": "(N1は)N2ですか → はい、そうです / いいえ、N3です", "nghia": "N1 có phải là N2 không? Câu hỏi Có/Không, thêm か cuối câu và trả lời bằng はい hoặc いいえ", "vi_du": "あの人は先生ですか。"},
  {"id": "1-3", "mau": "Nも〜", "nghia": "N cũng ~: も thay cho は khi nội dung giống điều vừa nói", "vi_du": "兄も医者です。"},
  {"id": "1-4", "mau": "(N1は)N2じゃありません", "nghia": "N1 không phải là N2: phủ định của câu danh từ", "vi_du": "これは私のかばんじゃありません。"},
  {"id": "1-5", "mau": "Nは何時から何時までですか → 〜から〜までです", "nghia": "N từ mấy giờ đến mấy giờ? Hỏi và trả lời khoảng thời gian", "vi_du": "図書館は何時から何時までですか。"},
  {"id": "1-6", "mau": "(Nは)いくらですか → Nは(số tiền)です", "nghia": "N bao nhiêu tiền? Hỏi và trả lời giá tiền", "vi_du": "このりんごはいくらですか。"},
  {"id": "1-7", "mau": "(N1は)何ですか → (N1は)N2です", "nghia": "N1 là cái gì? Hỏi tên đồ vật, nghề nghiệp", "vi_du": "あれは何ですか。"},
  {"id": "1-8", "mau": "〜ね", "nghia": "~ nhỉ: đặt cuối câu để tìm sự đồng cảm của người nghe", "vi_du": "今日は休みですね。"},
  {"id": "1-9", "mau": "〜よね / 〜よ", "nghia": "~ đúng không nhỉ (よね: xác nhận điều mình nghĩ là đúng), ~ đấy (よ: báo điều người nghe chưa biết)", "vi_du": "明日はテストですよね。"}
