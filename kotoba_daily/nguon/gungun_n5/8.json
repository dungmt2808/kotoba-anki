  {"id": "8-1", "mau": "(Nは)〜がV(thể khả năng)", "nghia": "N có thể V: nói về năng lực, khả năng", "vi_du": "妹は英語が話せます。"},
  {"id": "8-2", "mau": "N(phương tiện, công cụ)でV / 何でVか", "nghia": "V bằng N: で chỉ phương tiện, công cụ", "vi_du": "毎日自転車で会社へ行きます。"},
  {"id": "8-3", "mau": "Số tiền/khoảng thời gian＋かかります/くらいです", "nghia": "Tốn, mất ~ (tiền, thời gian)", "vi_du": "家から駅まで十分くらいかかります。"},
  {"id": "8-4", "mau": "Số tiền/khoảng thời gianで＋V / いくら/どのくらい＋で＋Vか", "nghia": "V với (số tiền), trong (khoảng thời gian): で chỉ giới hạn, thường đi với thể khả năng", "vi_du": "この服は千円で買えます。"},
  {"id": "8-5", "mau": "N1はN2が好き/嫌い/上手/下手/得意/苦手＋だ/です", "nghia": "N1 thích, ghét, giỏi, kém N2: đối tượng đứng trước が", "vi_du": "私は料理が苦手です。"},
  {"id": "8-6", "mau": "〜から、〜", "nghia": "Vì ~ nên ~: から nêu lý do", "vi_du": "雨ですから、出かけません。"},
  {"id": "8-7", "mau": "N1はN2がAです", "nghia": "N1 có N2 mang đặc điểm A: nói đặc điểm, tính chất", "vi_du": "この町は魚がおいしいです。"},
  {"id": "8-8", "mau": "N1がN2/Aです / N1がVます", "nghia": "が đánh dấu thông tin mới, điều muốn nhấn mạnh; bắt buộc dùng sau từ để hỏi", "vi_du": "誰がこの絵を描きましたか。"}
