 "ngu_phap": [
  {"id": "13-1", "mau": "N1でも(N2でも)いい/大丈夫です・構わないです/構いません・V(thể khả năng)", "nghia": "N1 (hay N2) cũng được: chấp nhận phương án dù không phải tối ưu", "vi_du": "カードでも大丈夫です。"},
  {"id": "13-2", "mau": "Vてもいいですか → はい、大丈夫です・どうぞ / すみません、(〜は)ちょっと…", "nghia": "V có được không? Xin phép và cách trả lời", "vi_du": "ここに座ってもいいですか。"},
  {"id": "13-3", "mau": "Vてもいいです", "nghia": "V cũng được: cho phép", "vi_du": "この部屋を使ってもいいです。"},
  {"id": "13-4", "mau": "Vなくてもいいです", "nghia": "Không cần V cũng được", "vi_du": "明日は来なくてもいいです。"},
  {"id": "13-5", "mau": "Vて＋ください(→Vて) / Vない＋で＋ください(→Vないで)", "nghia": "Hãy V, xin đừng V; dạng thân mật bỏ ください", "vi_du": "図書館で電話しないでください。"},
  {"id": "13-6", "mau": "Vて＋くれますか(→Vてくれる？)", "nghia": "Bạn V cho tôi được không? Nhờ người ngang hàng, thân mật", "vi_du": "ちょっと手伝ってくれる？"},
  {"id": "13-7", "mau": "Vて＋くれませんか / Vて＋くださいませんか", "nghia": "Bạn có thể V cho tôi không? Nhờ vả lịch sự hơn", "vi_du": "窓を閉めてくださいませんか。"},
  {"id": "13-8", "mau": "N1は/が(私に)N2をくれる/くださる", "nghia": "N1 cho tôi N2; くださる dùng khi N1 là người trên", "vi_du": "友達が私に本をくれました。"},
  {"id": "13-9", "mau": "Nは/が(私に)〜Vてくれる/Vてくださる", "nghia": "N làm V cho tôi", "vi_du": "父が駅まで送ってくれました。"},
  {"id": "13-10", "mau": "N1は/がN2にN3をあげる/さしあげる", "nghia": "N1 cho, tặng N2 N3; さしあげる dùng khi N2 là người trên", "vi_du": "私は妹に時計をあげました。"},
  {"id": "13-11", "mau": "N1は/がN2にVて＋あげる/さしあげる", "nghia": "N1 làm V cho N2", "vi_du": "友達に日本語を教えてあげました。"}
 ],
