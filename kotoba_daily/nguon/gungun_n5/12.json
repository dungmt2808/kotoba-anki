 "ngu_phap": [
  {"id": "12-1", "mau": "て形 (thể て)", "nghia": "Cách chia thể て của động từ, nền tảng của nhiều mẫu câu", "vi_du": "本を読んで、寝ました。"},
  {"id": "12-2", "mau": "V1て、V2て、〜", "nghia": "V1 rồi V2 rồi...: nối các hành động theo thứ tự", "vi_du": "朝起きて、顔を洗って、ご飯を食べます。"},
  {"id": "12-3", "mau": "V1てからV2", "nghia": "Sau khi V1 xong thì mới V2: nhấn mạnh thứ tự", "vi_du": "手を洗ってからご飯を食べます。"},
  {"id": "12-4", "mau": "(Nは)Vています (hành động đang diễn ra)", "nghia": "N đang V", "vi_du": "弟は今、部屋でゲームをしています。"},
  {"id": "12-5", "mau": "NがVています (hiện tượng xảy ra trước mắt)", "nghia": "N đang V: tả điều đang thấy, đang nghe trước mắt", "vi_du": "あ、雪が降っています。"},
  {"id": "12-6", "mau": "(Nは)Vています (thói quen, hành động lặp lại)", "nghia": "N thường V", "vi_du": "毎朝ジョギングをしています。"},
  {"id": "12-7", "mau": "NがVています (trạng thái, kết quả của hành động)", "nghia": "N ở trạng thái do V để lại: kết quả của hành động vẫn còn", "vi_du": "電気がついています。"},
  {"id": "12-8", "mau": "(Nは)Vています (trạng thái duy trì trong thời gian dài)", "nghia": "N V trong thời gian dài: nơi sống, nghề nghiệp, tình trạng", "vi_du": "姉は東京に住んでいます。"},
  {"id": "12-9", "mau": "Nを知っていますか → はい、知っています / いいえ、知りません・知りませんでした", "nghia": "Có biết N không? Trả lời phủ định dùng 知りません, không dùng 知っていません", "vi_du": "この歌を知っていますか。"}
 ],
