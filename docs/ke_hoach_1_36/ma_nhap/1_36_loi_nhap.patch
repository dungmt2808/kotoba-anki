+    12: {"kind": "cay", "part": "purple", "name": "Quả châu tím", "desc": "Hai quả châu tím"},
+    13: {"kind": "qua", "box": 2, "item": {"le_gaubong": 1}, "name": "Hộp quà bí mật", "desc": "Đặt dưới gốc cây · mở sáng 25/12"},
